# Pre-installed extensions, fetched and hash-checked by scripts/wren_addons.py.
# They land in <app>/distribution/extensions, which Firefox installs into
# every new profile (and again after an app update) as normal add-ons.
DIST_SUBDIR = ""

FINAL_TARGET_FILES.distribution.extensions += [
    "uBlock0@raymondhill.net.xpi",
]
