# Wren's first-run page. Served as resource://wren-welcome/ so it loads like an
# ordinary, unprivileged web page (the same way pdf.js serves its viewer).
% resource wren-welcome %content/browser/wren-welcome/
        content/browser/wren-welcome/index.html                                  (../../zen/wren-welcome/index.html)
        content/browser/wren-welcome/wren-bird.png                               (../../zen/wren-welcome/wren-bird.png)
